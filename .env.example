# Obligatoire en production : signe les sessions administrateur et les documents téléversés.
# Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# Base de données PostgreSQL. Sans elle, l'app écrit dans .data/db.json — pratique en local,
# mais Vercel efface ce fichier à chaque déploiement : indispensable en production.
#
# NE CRÉEZ PAS cette variable à la main sur Vercel : une DATABASE_URL vide empêche
# l'intégration Neon de créer la sienne. Passez par Storage → Neon → Connect Project,
# qui la remplit tout seul. Ici, en local, laissez la ligne vide ou supprimez-la.
#
# Si vous avez choisi un préfixe personnalisé sur Vercel (STORAGE_DATABASE_URL par
# exemple), rien à faire : l'app reconnaît le suffixe quel que soit le préfixe.
DATABASE_URL=

# Stockage des CV et lettres. Sans ce jeton, les fichiers vont dans .data/uploads.
# Vercel → Storage → Blob le remplit tout seul, même remarque : ne le créez pas à la main.
BLOB_READ_WRITE_TOKEN=
