# ── Obligatoire ───────────────────────────────────────────────────────────────

# Signe les sessions administrateur et les documents téléversés.
# Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# La base Postgres de l'enseigne.
# L'application y crée ses tables toute seule au premier démarrage : le compte
# doit donc avoir le droit de créer des tables dans cette base.
# Sans elle, l'application écrit dans .data/db.json : pratique en développement,
# jamais en production.
#
# ⚠️ Ne créez pas cette variable vide « pour plus tard » : une variable présente
# mais vide empêche certains hébergeurs d'injecter la vraie.
DATABASE_URL=

# Où sont rangés les CV et lettres de motivation.
# ⚠️ HORS du dossier de l'application : un déploiement recopie le dépôt et
# effacerait un dossier situé à l'intérieur. Incluez-le dans vos sauvegardes.
UPLOAD_DIR=/srv/candidatures/enseigne


# ── Envoi d'e-mails ───────────────────────────────────────────────────────────

# Accusé de réception au candidat, alerte au recruteur. Sans cette variable,
# rien n'est envoyé — et l'écran des réglages le dit, plutôt que d'échouer en
# silence à chaque candidature.
#
# Les identifiants vivent ici et jamais en base : un administrateur d'enseigne
# règle les modèles de message, il n'a pas à pouvoir lire ce mot de passe ni à
# l'emporter dans un export.
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465


# ── Facultatif ────────────────────────────────────────────────────────────────

# Port d'écoute (3210 par défaut) — celui que le domaine public réécrit.
# PORT=3210

# Préfixe d'URL (/candidature par défaut). La chaîne vide sert l'application à
# la racine du domaine ; les adresses des QR codes suivent automatiquement.
# BASE_PATH=/candidature
