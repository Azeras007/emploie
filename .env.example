# ── Obligatoire ───────────────────────────────────────────────────────────────

# Signe les sessions administrateur et les documents téléversés.
# Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# La base Valeur Ajoutée — la MÊME que celle du site.
# Sur le Mac Mini : postgresql://…@localhost:5432/valeur_ajoutee
# Sans elle, l'application écrit dans .data/db.json : pratique en développement,
# jamais en production.
DATABASE_URL=

# Où sont rangés les CV et lettres de motivation.
# ⚠️ HORS du dossier de l'application : un déploiement recopie le dépôt et
# effacerait un dossier situé à l'intérieur. Incluez-le dans vos sauvegardes.
UPLOAD_DIR=/Users/quentinmini/candidatures-fichiers


# ── Facultatif ────────────────────────────────────────────────────────────────

# Port d'écoute (3210 par défaut) — celui que le site principal réécrit.
# PORT=3210

# Préfixe d'URL (/candidature par défaut).
# BASE_PATH=/candidature
