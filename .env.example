# Obligatoire en production : signe les sessions administrateur et les documents téléversés.
# Générez-le avec :  openssl rand -base64 32
AUTH_SECRET=

# Base de données PostgreSQL. Sans elle, l'app écrit dans .data/db.json — pratique en local,
# mais Vercel efface ce fichier à chaque déploiement : indispensable en production.
# Vercel → Storage → Postgres (Neon) remplit POSTGRES_URL tout seul.
DATABASE_URL=

# Stockage des CV et lettres. Sans ce jeton, les fichiers vont dans .data/uploads.
# Vercel → Storage → Blob remplit BLOB_READ_WRITE_TOKEN tout seul.
BLOB_READ_WRITE_TOKEN=
